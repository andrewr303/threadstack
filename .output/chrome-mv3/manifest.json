{
  "manifest_version": 3,
  "name": "Threadkeeper",
  "version": "0.5.0",
  "version_name": "0.5.0 (build 20261121.181910-5adc60f8a)",
  "description": "Automatically captures, understands and organizes your AI threads across ChatGPT, Claude, Claude Code, Codex, Grok, Gemini and more.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "sidePanel",
    "activeTab",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "webRequest"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://www.copilot.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://kimi.ai/*",
    "https://api.anthropic.com/*",
    "https://api.voyageai.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*.api.aws/*",
    "https://*.amazonaws.com/*",
    "https://ai.mongodb.com/*",
    "https://us.ai.mongodb.com/*",
    "https://eu.ai.mongodb.com/*",
    "https://api.cohere.com/*",
