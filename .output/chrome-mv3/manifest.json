        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.ai/*"
      ],
      "js": [
        "content-scripts/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content-scripts/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
