    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://poe.com/*",
    "https://huggingface.co/*",
    "https://chat.qwen.ai/*",
    "https://www.doubao.com/*",
    "https://chat.z.ai/*",
    "https://zchat.z.ai/*",
    "https://manus.im/*",
    "https://www.manus.im/*",
    "https://www.genspark.ai/*",
    "https://genspark.ai/*",
    "https://agent.minimax.io/*",
    "https://agent.minimaxi.com/*",
    "https://character.ai/*",
    "https://duck.ai/*",
    "https://lumo.proton.me/*",
    "https://arena.ai/*",
    "https://lmarena.ai/*",
    "https://t3.chat/*",
    "https://notebook.google.com/*",
    "https://notebooklm.google.com/*",
    "https://github.com/*",
