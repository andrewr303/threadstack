  "devDependencies": { "@types/node": "^24.0.0", "@types/react": "^19.2.18", "@types/react-dom": "^19.3.0", "esbuild": "^0.28.2", "react": "^19.2.8", "react-dom": "^19.3.1", "typescript": "^7.0.2", "vitest": "^5.0.3" },
